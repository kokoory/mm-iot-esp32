menu "Morse Micro Shim Configuration"
    config MM_RESET_N
        int "RESET_N pin for MM chip"
        default 1
        help
            Output gpio pin used to control the RESET_N line.
            Default is GPIO 1 (XIAO D0) for Seeed Studio XIAO ESP32S3 + WM6180 HaLow.

    config MM_WAKE
        int "WAKE pin for MM chip"
        default 2
        help
            Output gpio pin used to control the WAKE line.
            Default is GPIO 2 (XIAO D1) for Seeed Studio XIAO ESP32S3 + WM6180 HaLow.

    config MM_BUSY
        int "BUSY pin for the MM chip"
        default 5
        help
            Input pin used as a rising edge interrupt.
            Default is GPIO 5 (XIAO D4) for Seeed Studio XIAO ESP32S3 + WM6180 HaLow.
            Note: BUSY pin is not wired on Seeed XIAO HaLow boards.
            Power save must be disabled as a workaround.

    config MM_SPI_SCK
        int "SCK pin for MM chip"
        default 7
        help
            SPI clock pin.
            Default is GPIO 7 (XIAO D8/SCK) for Seeed Studio XIAO ESP32S3 + WM6180 HaLow.

    config MM_SPI_MOSI
        int "MOSI pin for MM chip"
        default 9
        help
            SPI master out slave in pin.
            Default is GPIO 9 (XIAO D10/MOSI) for Seeed Studio XIAO ESP32S3 + WM6180 HaLow.

    config MM_SPI_MISO
        int "MISO pin for MM chip"
        default 8
        help
            SPI master in slave out pin.
            Default is GPIO 8 (XIAO D9/MISO) for Seeed Studio XIAO ESP32S3 + WM6180 HaLow.

    config MM_SPI_CS
        int "SPI CS pin for MM chip"
        default 4
        help
            SPI chip select pin.
            Default is GPIO 4 (XIAO D3) for Seeed Studio XIAO ESP32S3 + WM6180 HaLow.

    config MM_SPI_IRQ
        int "SPI IRQ pin for MM chip"
        default 3
        help
            Out of band interupt pin used to indicate that
            the MM chip has data for the host.
            Default is GPIO 3 (XIAO D2) for Seeed Studio XIAO ESP32S3 + WM6180 HaLow.

    config MM_BCF_FILE
        string "MM Board Configuration File"
        default "bcf_mf08651_us.mbin"
        help
            Set the name of the BCF (Board Configuration File) to use.

            This file provides board-specific configuration data for the Morse Micro chip/module.

            The build system will search for the specified file in the following locations:
              1. morsefirmware/ in the root of the application being built
              2. framework/morsefirmware/ in the mm-iot-esp32 SDK (defined via the MMIOT_ROOT environment variable)

            If the file is not found in either location, a warning will be reported during
            configuration.

    config MM_FW_FILE
        string "MM Firmware File"
        default "mm6108.mbin"
        help
            This is the firmware file for the Morse Micro chip/module.

            The build system will search for the specified file in the following locations:
              1. morsefirmware/ in the root of the application being built
              2. framework/morsefirmware/ in the mm-iot-esp32 SDK (defined via the MMIOT_ROOT environment variable)

            If the file is not found in either location, a warning will be reported during
            configuration.

    choice MMHAL_CHIP_TYPE
        bool "MM Chip Ops"
        default MMHAL_CHIP_TYPE_MM6108
        help
            This specifies which chip function ops should be used by morselib.

        config MMHAL_CHIP_TYPE_MM6108
            bool "mmhal_mm6108"
        config MMHAL_CHIP_TYPE_MM8108
            bool "mmhal_mm8108"
    endchoice
endmenu
