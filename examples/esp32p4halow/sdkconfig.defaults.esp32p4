#
# ESP32-P4 HaLow Pin Configuration
#
# Available GPIOs: 2,3,4,5,20,21,22,23,26,27,32,33,46,47,48,49,50
#
# HaLow SPI pins
CONFIG_MM_RESET_N=20
CONFIG_MM_WAKE=23
CONFIG_MM_BUSY=32
CONFIG_MM_SPI_SCK=5
CONFIG_MM_SPI_MOSI=3
CONFIG_MM_SPI_MISO=2
CONFIG_MM_SPI_CS=4
CONFIG_MM_SPI_IRQ=21
CONFIG_MM_BCF_FILE="bcf_mf08651_us.mbin"

# MIPI-CSI camera uses dedicated MIPI lanes (not GPIO)
# Camera I2C (IMX219 SCCB): SCL=GPIO33, SDA=GPIO22
# UART for MAVLink: TX=GPIO26, RX=GPIO27
# Free GPIOs: 46, 47, 48, 49, 50
