#
# ESP32-P4 HaLow Pin Configuration
#
# Available GPIOs: 2,3,4,5,20,21,22,23,26,27,32,33,46,47,48,49,50
#
# HaLow SPI pins
CONFIG_MM_RESET_N=20
CONFIG_MM_WAKE=23
CONFIG_MM_BUSY=32
CONFIG_MM_SPI_SCK=5
CONFIG_MM_SPI_MOSI=3
CONFIG_MM_SPI_MISO=2
CONFIG_MM_SPI_CS=4
CONFIG_MM_SPI_IRQ=21
CONFIG_MM_BCF_FILE="bcf_fgh100mhaamd.mbin"

# MIPI-CSI camera (OV5647 / RPi Camera v1)
# CSI uses dedicated MIPI differential pairs (not GPIO)
# SCCB (I2C) for sensor control: SCL=GPIO8, SDA=GPIO7
# LDO channel 3 at 2500mV powers the MIPI PHY
CONFIG_CAMERA_OV5647=y
CONFIG_CAMERA_OV5647_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y

# UART for MAVLink: TX=GPIO26, RX=GPIO27
# Free GPIOs: 22, 33, 46, 47, 48, 49, 50
