#
# ESP32-P4 specific configuration for Helicopter Flight Controller
# Hardware: Waveshare ESP32-P4-Module-DEV-KIT + MMECH06
#
# Based on working reference: examples/esp32p4halow/sdkconfig.defaults.esp32p4
#

# ── HaLow SPI pins (matching reference exactly) ──
CONFIG_MM_RESET_N=20
CONFIG_MM_WAKE=23
CONFIG_MM_BUSY=32
CONFIG_MM_SPI_SCK=5
CONFIG_MM_SPI_MOSI=3
CONFIG_MM_SPI_MISO=2
CONFIG_MM_SPI_CS=4
CONFIG_MM_SPI_IRQ=21
CONFIG_MM_BCF_FILE="bcf_fgh100mhaamd.mbin"

# ── Camera (OV5647 via MIPI-CSI, matching reference) ──
CONFIG_CAMERA_OV5647=y
CONFIG_CAMERA_OV5647_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
